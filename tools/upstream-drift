#!/usr/bin/env python3
"""Report vendored skills whose upstream has moved past the revision we pinned.

WHAT THIS DOES NOT DO, AND WHY THE BRIEF ASKED FOR IT ANYWAY.

The brief said "weekly upstream-sync action opening a PR". It opens an ISSUE,
because nothing in either repository can fill that PR. `gtmsrv/cmd/vendorfetch`
fetches upstream bytes AT THE SHA THE SKILL ALREADY NAMES — it verifies a pin, it
cannot see past one — and its own header says it deliberately does not write app
copies, because the writer that does is elsewhere and was rebuilt after producing
116 truncated descriptions and nine files of invalid YAML. `tools/vendor-skill`,
which CONTRIBUTING names as the only sanctioned way to vendor, does not exist.

So a job claiming to open a re-vendored PR would be an accurate-sounding
instruction pointing at something that cannot be done — the failure this tree has
found four times in two days, and the one that survives longest because it reads
like diligence. Detection is the half that can be done honestly, and it delivers
the property that was actually wanted: a drifting upstream becomes a review
rather than a surprise.

When a writer exists, this changes its verb and the issue body becomes the PR
body. That is a one-line change to the workflow, not a rewrite of this.

WHAT IT CHECKS. Each entry in skills.lock carries `source`, a GitHub blob URL
naming owner, repo, revision and path. For each distinct (repo, path) this asks
the API for the newest commit touching that path on the default branch, and
compares it against the pinned revision.

WHAT IT DELIBERATELY DOES NOT TREAT AS DRIFT. A newer commit that did not touch
the file is not drift, which is why this queries `commits?path=` rather than the
branch head: pinning per file means a repository that moves for unrelated reasons
is silent here, and only a change to a page we actually vendored speaks.
"""
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

BLOB = re.compile(r"^https://github\.com/([^/]+)/([^/]+)/blob/([0-9a-f]{7,40})/(.+)$")
API = "https://api.github.com"


def latest_commit(owner, repo, path, token):
    """The newest commit touching one path, or None when the API will not say."""
    url = f"{API}/repos/{owner}/{repo}/commits?path={urllib.parse.quote(path)}&per_page=1"
    req = urllib.request.Request(url, headers={
        "Accept": "application/vnd.github+json",
        "User-Agent": "freegtm-upstream-drift",
        **({"Authorization": f"Bearer {token}"} if token else {}),
    })
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            body = json.load(r)
    except urllib.error.HTTPError as e:
        # A 404 is a real finding — the page we vendored is gone upstream — and
        # is reported rather than swallowed. Everything else is the network
        # having a bad day and must not read as "no drift".
        if e.code == 404:
            return "GONE"
        raise
    return body[0]["sha"] if body else None


def main():
    lock_path = sys.argv[1] if len(sys.argv) > 1 else "skills.lock"
    lock = json.load(open(lock_path))
    token = os.environ.get("GITHUB_TOKEN", "")

    # One query per distinct (repo, path): 116 skills resolve to about 103
    # sources, and several apps vendor the same page.
    # Sets, not lists: two apps commonly vendor the same page — 116 skills
    # resolve to 103 sources — and counting the copies would report "2 pages
    # moved" about one page. A number in a report that means something other
    # than it says is the defect this whole tool exists around.
    seen, drifted, gone, unresolved = {}, set(), set(), []
    for entry in lock["skills"]:
        m = BLOB.match(entry.get("source") or "")
        if not m:
            unresolved.append(entry["app"] + "/" + entry["skill"])
            continue
        owner, repo, pinned, path = m.groups()
        key = (owner, repo, path)
        if key not in seen:
            seen[key] = latest_commit(owner, repo, path, token)
        head = seen[key]
        if head == "GONE":
            gone.add((f"{owner}/{repo}", path, pinned))
        elif head and not head.startswith(pinned) and not pinned.startswith(head):
            drifted.add((f"{owner}/{repo}", path, pinned, head))

    if unresolved:
        print(f"{len(unresolved)} entries have a source that does not parse as a GitHub blob URL:")
        for u in sorted(unresolved):
            print(f"  {u}")

    if gone:
        print(f"\n{len(gone)} vendored page(s) no longer exist upstream:")
        for repo, path, pinned in sorted(gone):
            print(f"  {repo} {path} (pinned {pinned[:12]})")

    if drifted:
        print(f"\n{len(drifted)} vendored page(s) have moved upstream:")
        for repo, path, pinned, head in sorted(drifted):
            print(f"  {repo} {path}")
            print(f"      pinned {pinned[:12]} → upstream {head[:12]}")
            print(f"      https://github.com/{repo}/compare/{pinned}...{head}")

    if not drifted and not gone and not unresolved:
        print(f"{len(seen)} vendored sources checked; every one is still at the revision we pinned.")
        return 0
    # Non-zero so the workflow can branch on it. This is NOT a build failure —
    # upstream moving is normal and is a thing to read, not to fix in a hurry.
    return 1


if __name__ == "__main__":
    sys.exit(main())
