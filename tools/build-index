#!/usr/bin/env python3
"""Generate marketplace.json and each app's plugin.json.

app.yaml IS THE ONLY HAND-WRITTEN METADATA. Everything this writes is derived
from it, so the plugin door and the connector door describe the same app because
they are projections of one file, not two files somebody keeps in step.

Never edit the outputs, for the same reason `built_on` is derived rather than
typed: two descriptions of one thing agree until somebody edits one, and the
disagreement is invisible.

INDEX.JSON IS NOT WRITTEN HERE ANY MORE. It carries two fields this cannot
derive: `requires`, which is nested past what this deliberately small reader
parses, and `needs_answered` — every value that must have been said before an
app runs, which is the union of what its prose asks for and what its gates
require. The prose half is only knowable by composing. The obvious shortcut,
matching braces across instructions and skill bodies, is a helper the gtmsrv
tree already wrote once and its instructions guard already refused; it is also
exactly how a vendored skill reached a model carrying 45 unfilled `{{CRM}}`-style
tokens, because a hand-rolled scan matches what its author thought of and that
author thought in lowercase. A second implementation here would be that same
scan again, in a language none of those guards can see.

So `gtmsrv/cmd/appindex` writes index.json from the loader, and this writes the
two outputs that are pure manifest metadata. Both run against this directory:

    go run ./cmd/appindex <apps-repo>/apps <apps-repo>/index.json
    python3 tools/build-index

`tools/check-generated` regenerates both into a copy of the repo and diffs, so a
manifest edited without rerunning them fails rather than quietly leaving outputs
that describe the previous state. This file previously claimed CI already did
that while `.github/workflows` was empty, which is why the check exists and why
it is named after what it does rather than what it protects.

The workflow that runs it needs a checkout credential for gtmsrv that does not
exist yet, so CI fails until somebody creates it. Run the check by hand until
then; it takes no arguments in the normal case.
"""
import json, os, sys, re

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
APPS = os.path.join(ROOT, "apps")


def read_manifest(path):
    """A deliberately small YAML reader: the fields the index needs, nothing more.

    Not a YAML library, because this runs in CI on a public repo and a
    dependency is a supply chain. The loader in gtmsrv does the real parsing and
    `validate` is what enforces the schema — this only projects what it finds,
    and anything it cannot read it leaves out rather than guessing.
    """
    out, key = {}, None
    for line in open(path, encoding="utf-8"):
        if line.startswith("#") or not line.strip():
            continue
        m = re.match(r"^([a-z_]+):\s*(.*)$", line)
        if m:
            key, val = m.group(1), m.group(2).strip()
            out[key] = val.strip('"') if val else []
            continue
        m = re.match(r"^\s+-\s+(.*)$", line)
        if m and isinstance(out.get(key), list):
            out[key].append(m.group(1).strip().strip('"'))
            continue
        m = re.match(r"^\s+([a-z_]+):\s*(.*)$", line)
        if m and key in ("maintained_by",):
            if not isinstance(out[key], dict):
                out[key] = {}
            out[key][m.group(1)] = m.group(2).strip().strip('"')
    return out


def apps():
    # Keyed by directory, which is unique in this repo. NOTE for whoever writes
    # vendor-skill or anything that joins on skill name across authors: a skill
    # is keyed by (author, name), never name alone — `research` already exists
    # twice in the library, and a name-only lookup gave our skill somebody
    # else's description with every field well formed. See CONTRIBUTING.

    for name in sorted(os.listdir(APPS)):
        p = os.path.join(APPS, name, "app.yaml")
        if os.path.isfile(p):
            yield name, read_manifest(p)


def main():
    entries, plugins = [], []
    for slug, m in apps():
        who = m.get("maintained_by") or {}
        entry = {
            "slug": slug,
            "name": m.get("name", slug),
            "description": m.get("description", ""),
            "category": m.get("category", ""),
            "version": m.get("version", ""),
            "license": m.get("license", ""),
            "say": m.get("say", []),
            "skills": m.get("skills", []),
            "maintained_by": who,
        }
        entries.append(entry)
        plugin = {
            "name": slug,
            "source": f"./apps/{slug}",
            "description": entry["description"],
            "version": entry["version"],
        }
        if who.get("name"):
            plugin["author"] = {"name": who["name"]}
        plugins.append(plugin)

        # Each app is also a plugin in its own right.
        pdir = os.path.join(APPS, slug, ".claude-plugin")
        os.makedirs(pdir, exist_ok=True)
        pj = {"name": slug, "description": entry["description"], "version": entry["version"]}
        if who.get("name"):
            pj["author"] = {"name": who["name"]}
        write(os.path.join(pdir, "plugin.json"), pj)

    write(os.path.join(ROOT, ".claude-plugin", "marketplace.json"), {
        "$schema": "https://code.claude.com/schemas/marketplace.json",
        "name": "freegtmapps",
        "owner": {"name": "freegtm", "url": "https://github.com/freegtmapps"},
        "plugins": plugins,
    })
    print(f"generated marketplace.json and {len(plugins)} plugin.json")
    print("index.json is written by gtmsrv/cmd/appindex, which is where the loader is")


def write(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(obj, f, indent=2)
        f.write("\n")


if __name__ == "__main__":
    sys.exit(main())
